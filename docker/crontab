# Actualización automática del catálogo (hora America/Bogota).
# Pasos de imágenes (descarga + Cloudinary) solo los domingos a las 3am.
# De lunes a sábado y corridas del día se usa --skip-images (solo datos).
# Hoja INVENTARIO_BODEGAS: 08:00, 15:00 y 18:00; solo esas tareas suben el archivo.
# min hora * * *   comando
0  3  * * 1-6  cd /app && python actualizar_catalogo.py --skip-images --wait-for-lock >> /app/data/cron_catalogo.log 2>&1; echo "[cron] exit=$? $(date '+\%Y-\%m-\%d \%H:\%M:\%S')" >> /app/data/cron_catalogo.log
